; todo: this will probably have to change once we design memory model and local variables
structure fib
(
    rec = λ a b i → out
    (
        jsvalue   dup  b     → b₁ a'
        jsvalue   add  b₁ a  → b'

        jsvalue   cons_1     → one
        jsvalue   sub  i one → i'

        fib   loop               → cont
        fᵢᵢᵢⁱ call cont a' b' i' → out
    )

    base = λ a b i → out
    (
        jsvalue drop a
        jsvalue drop i
        jsvalue move b → out
    )

    frame = λ A B a b i → out
    (
        jsvalue dup a → a₁ a₂
        jsvalue dup b → b₁ b₂
        jsvalue dup i → i₁ i₂

        fᵢᵢᵢⁱ call A a₁ b₁ i₁ → out₁
        fᵢᵢᵢⁱ call B a₂ b₂ i₂ → out₂
        jsvalue join out₁ out₂ → out
    )

    loop = λ a b i → out
    (
        jsvalue cons_0      → zero
        jsvalue dup i       → i₁ i₂
        jsvalue le? i₁ zero → cmp

        jsvalue dup cmp   → cmp₁ cmp₂
        jsvalue not cmp₂  → cmp₃

        fib base  → base
        fib rec   → rec
        fib frame → frame

        fᵢᵢᵢⁱ opt cmp₁ base → alt₁
        fᵢᵢᵢⁱ opt cmp₃ rec  → alt₂

        fᵢᵢᵢⁱ join alt₁ alt₂ frame → cont
        fᵢᵢᵢⁱ call cont a b i₂     → out
    )

    compute = λ in → out
    (
        jsvalue  cons_1    → a ; construct 1 on stack $a
        jsvalue  cons_1    → b ; construct 1 on stack $b
        jsvalue  cons_2    → x ; construct 2 on stack $x

        jsvalue  sub  in x → i

        fib   loop            → cont
        fᵢᵢᵢⁱ call cont a b i → out
    )
)

structure main
(
    run = λ
    (
        jsvalue cons_5 → a

        fib compute        → program
        fᵢⁱ call program a → out

        jsvalue cons_5  → b
        jsvalue eq?  out b → c

        jsvalue assert c
    )
)
