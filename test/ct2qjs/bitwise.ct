structure main
(
    run = λ
    (
        jsvalue cons_6 → a0
        jsvalue cons_3 → b0
        jsvalue band a0 b0 → r0
        jsvalue cons_2 → expect0    ; 6 & 3 == 2
        jsvalue eq? r0 expect0 → ok0
        jsvalue assert ok0

        jsvalue cons_6 → a1
        jsvalue cons_3 → b1
        jsvalue bor a1 b1 → r1
        jsvalue cons_7 → expect1    ; 6 | 3 == 7
        jsvalue eq? r1 expect1 → ok1
        jsvalue assert ok1

        jsvalue cons_6 → a2
        jsvalue cons_3 → b2
        jsvalue bxor a2 b2 → r2
        jsvalue cons_5 → expect2    ; 6 ^ 3 == 5
        jsvalue eq? r2 expect2 → ok2
        jsvalue assert ok2

        jsvalue cons_6   → a3
        jsvalue bnot a3  → r3       ; ~6 == -7
        jsvalue cons_7   → seven
        jsvalue add r3 seven → r3sum
        jsvalue cons_0   → zero
        jsvalue eq? r3sum zero → ok3
        jsvalue assert ok3

        jsvalue cons_1 → a4
        jsvalue cons_3 → b4
        jsvalue shl a4 b4 → r4
        jsvalue cons_8 → expect4    ; 1 << 3 == 8
        jsvalue eq? r4 expect4 → ok4
        jsvalue assert ok4

        jsvalue cons_8 → a5
        jsvalue cons_3 → b5
        jsvalue shr a5 b5 → r5
        jsvalue cons_1 → expect5    ; 8 >> 3 == 1
        jsvalue eq? r5 expect5 → ok5
        jsvalue assert ok5
    )
)
