type stck

type func

type jsvalue ; every js runtime value
type tag
type num
type str
type bool
type obj

signature lattice[ T, B ]
(
    join ∷ T × T → T
    bot  ∷ ∅ → T
    top  ∷ ∅ → T
    opt  ∷ B × T → T
)

signature linear[ T, S, B ] : lattice[ T, B ]
(
    fork ∷ T → T × T
    move ∷ T → T
    push ∷ S × T → S
    pop  ∷ S → T × S
)

signature affine[ T, S, B ] : linear[ T, S, B ]
(
    drop ∷ T → ∅
)

signature simple[ T, S, B ] : affine[ T, S, B ]
(
    dup ∷ T → T × T
)

signature arithmetic[ T, S, B ] : simple[ T, S, B ]
(
    add ∷ T × T → T
    sub ∷ T × T → T
    mul ∷ T × T → T
    div ∷ T × T → T
    rem ∷ T × T → T ; %

    eq? ∷ T × T → B
    ne? ∷ T × T → B ; !=
    lt? ∷ T × T → B
    le? ∷ T × T → B
    gt? ∷ T × T → B
    ge? ∷ T × T → B

    cons ∷ ∅ → T ; we should be able to create cons instructions on demand
)

signature bitwise[ T ]
(
    band ∷ T × T → T
    bor  ∷ T × T → T
    bxor ∷ T × T → T
    bnot ∷ T → T
    shl  ∷ T × T → T
    shr  ∷ T × T → T
)

; base signature for functions ( although this will most likely have to change once we support first-class functions )
signature f₁¹[ F, S, B, I, O ] : simple[ F, S, B ]
(
    call ∷ F × I → O
    opt  ∷ B × F → F
    join ∷ F × F × F → F
)